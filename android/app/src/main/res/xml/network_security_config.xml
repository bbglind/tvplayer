<?xml version="1.0" encoding="utf-8"?>
<!-- Providers are chosen by the user and often serve plain http://, so
     cleartext can't be limited to known domains. HTTPS still uses the
     system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
